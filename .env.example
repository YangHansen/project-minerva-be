NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Leave empty to start the API in degraded mode without persistence.
MONGODB_URI=mongodb://127.0.0.1:27017/minerva
# Used only if the runtime cannot resolve mongodb+srv records natively.
MONGODB_DOH_URL=https://cloudflare-dns.com/dns-query

# Generate a unique value of at least 32 characters. Never commit the real value.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_TTL_SECONDS=604800
# For cross-site frontend/API hosting, use none + true over HTTPS.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Elice is called by the backend only. Never expose this key as a VITE_* value.
ELICE_API_KEY=
ELICE_TERRA_BASE_URL=https://mlapi.run/e1ede337-92cd-45f8-b0a1-f7d58d337268
ELICE_WHISPER_BASE_URL=https://mlapi.run/805a20fb-b66b-4b7c-84fb-079c12b76937
ELICE_TIMEOUT_MS=120000

UPLOAD_DIRECTORY=./data/uploads
UPLOAD_MAX_BYTES=25000000
